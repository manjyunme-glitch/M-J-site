# PORT、TZ、DATABASE_PATH、UPLOAD_DIR 供本地 Node 开发使用；Compose 容器内使用同名固定配置。
PORT=1314
TZ=Asia/Shanghai
DATABASE_PATH=./data/love-journal.db
UPLOAD_DIR=./uploads
# 本地 Docker Desktop 使用项目目录；Portainer/NAS 可改为 /share/DockerData/M-J-site/...。
DATA_PATH=./data
UPLOAD_PATH=./uploads
# 使用 npm run hash-password -- <密码> 生成可直接用于 Docker Compose 的值，禁止填写明文密码。
SITE_PASSWORD_HASH=replace-with-bcrypt-hash
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# 至少 64 位随机字符串，例如：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=replace-with-long-random-secret
# 配置 HTTPS 反向代理后改为 true。
SECURE_COOKIES=false
# 使用 Nginx/Caddy 等反向代理时改为 true。
TRUST_PROXY=false
# GitHub 更新检查使用的 HTTP 代理。Portainer 中可直接按此填写。
APP_HTTP_PROXY=http://192.168.0.113:9890
APP_HTTPS_PROXY=http://192.168.0.113:9890
APP_NO_PROXY=localhost,127.0.0.1,::1
# 更新检查默认读取此仓库和分支；私有仓库需要配置只读 GITHUB_TOKEN。
GITHUB_REPOSITORY=manjyunme-glitch/M-J-site
GITHUB_BRANCH=main
# 私有仓库必须配置 fine-grained token，只授予 Contents: Read-only。
GITHUB_TOKEN=
# 可选：仅在 Docker 构建时能提供当前源码的真实值时填写；留空时部署状态显示“未知”。
APP_COMMIT_SHA=
APP_COMMIT_DATE=
APP_COMMIT_REF=
